{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/register", "destination": "/register.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/tasks", "destination": "/tasks.html" },
    { "source": "/withdraw", "destination": "/withdraw.html" },
    { "source": "/withdraw/receipt", "destination": "/withdraw-receipt.html" },
    { "source": "/profile", "destination": "/profile.html" },
    { "source": "/payment/:ref", "destination": "/payment.html" },
    { "source": "/admin", "destination": "/admin.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
